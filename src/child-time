#!/usr/bin/python3

"""Human-friendly administrator CLI for OFLIT Child Time Limit.

This script is a presentation/argument adapter: all policy semantics
(duration/clock parsing, config parsing, the transactional mutation
invariant, status computation) live in child_time_core, which this
script loads deterministically -- see _load_core() below.
"""

import argparse
import importlib.machinery
import importlib.util
import os
import sys
from pathlib import Path

_SCRIPT_PATH = Path(__file__).resolve()
_SIBLING_CORE = _SCRIPT_PATH.parent / "child_time_core.py"
_INSTALLED_CORE = Path("/usr/local/lib/child-time-limit/child_time_core.py")


def _load_core():
    """Resolve child_time_core.py deterministically.

    A source-tree checkout ships child_time_core.py next to this script,
    and that sibling always wins. An installed CLI (/usr/local/sbin/
    child-time) has no sibling core, so it falls back to the product-
    owned installed path. Both paths are re-checked on every call (no
    sys.path/sys.modules caching) so a stale installed module can never
    shadow an available sibling source module.
    """
    if _SIBLING_CORE.is_file():
        core_path = _SIBLING_CORE
    elif _INSTALLED_CORE.is_file():
        core_path = _INSTALLED_CORE
    else:
        raise ImportError(
            "Cannot locate child_time_core.py beside "
            f"{_SCRIPT_PATH} or at {_INSTALLED_CORE}"
        )

    loader = importlib.machinery.SourceFileLoader("child_time_core", str(core_path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"Cannot create import spec for {core_path}")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


core = _load_core()

# Compatibility aliases: presentation code below (and callers/tests that
# reach into this module) use these names directly, but the core module
# is the sole authoritative implementation.
ChildTimeError = core.ChildTimeError
StatusRow = core.StatusRow
LimitMutationResult = core.LimitMutationResult
parse_duration = core.parse_duration
parse_clock = core.parse_clock
validate_username = core.validate_username
load_config = core.load_config
read_used = core.read_used
policy_lock = core.policy_lock
atomic_update_limit = core.atomic_update_limit
_atomic_update_limit_locked = core._atomic_update_limit_locked
confirm_reduction = core.confirm_reduction
status_rows = core.status_rows
load_access_window = core.load_access_window
atomic_update_access_window = core.atomic_update_access_window
apply_limit_transaction = core.apply_limit_transaction
local_now = core.local_now
today = core.today
fmt = core.fmt
human = core.human


def require_root():
    if os.geteuid() != 0:
        raise ChildTimeError("Run as root, for example: sudo child-time status")


def print_status(selected=None):
    rows = core.status_rows(selected)

    print(f"OFLIT Child Time Limit — {today()}")
    print()
    print(
        f"{'USER':<20} {'USED':>10} {'REMAINING':>10} "
        f"{'LIMIT':>10} {'STATUS':>10}"
    )
    print("-" * 66)

    try:
        schedules = core.load_schedule_policy()
    except core.ChildTimeError:
        schedules = {}

    now = core.local_now()
    minute_of_day = now.hour * 60 + now.minute

    for row in rows:
        print(
            f"{row.username:<20} "
            f"{fmt(row.used):>10} "
            f"{fmt(row.remaining):>10} "
            f"{fmt(row.limit):>10} "
            f"{row.status:>10}"
        )

        slots = schedules.get(row.username, [])
        if not slots:
            continue

        slot_usage = core.read_schedule_used(
            row.username,
            slots,
        )

        scheduled_status = core.scheduled_status_detail(
            slots,
            slot_usage,
            minute_of_day,
        )

        if scheduled_status.slot_id is None:
            print("  Schedule : no more slots today")
            continue

        label = (
            "current"
            if scheduled_status.mode in ("ACTIVE", "EXHAUSTED")
            else "next"
        )

        print(
            f"  Schedule : {label} "
            f"{scheduled_status.slot_id} "
            f"[{scheduled_status.mode}] "
            f"used={fmt(scheduled_status.used)} "
            f"remaining={fmt(scheduled_status.remaining)}"
        )

def _print_mutation_result(result):
    print(f"User       : {result.username}")
    print(f"Used today : {fmt(result.used)} ({human(result.used)})")
    print(f"Old limit  : {fmt(result.old_limit)} ({human(result.old_limit)})")
    print(f"New limit  : {fmt(result.new_limit)} ({human(result.new_limit)})")
    print(f"Remaining  : {fmt(result.remaining)} ({human(result.remaining)})")
    if result.reason:
        print(f"Mode       : {result.reason}")
    print("Reload     : automatic; service restart is not required")


def command_window(args):
    if args.start is None and args.end is None:
        start, end = core.load_access_window()
        print(f"Access window: {start}–{end}")
        return

    if args.start is None or args.end is None:
        raise ChildTimeError("window requires both START and END, for example: child-time window 08:00 18:00")

    start, end = core.atomic_update_access_window(args.start, args.end)
    print(f"Access window updated: {start}–{end}")


def command_set(args):
    result = core.apply_limit_transaction(
        args.username,
        core.parse_duration(args.duration),
        force=args.force,
    )
    _print_mutation_result(result)


def command_add(args):
    delta = core.parse_duration(args.duration)
    result = core.apply_limit_transaction(
        args.username,
        lambda old_limit, used: old_limit + delta,
        reason=f"add {human(delta)}",
    )
    _print_mutation_result(result)


def command_subtract(args):
    delta = core.parse_duration(args.duration)

    def subtract(old_limit, used):
        new_limit = old_limit - delta
        if new_limit <= 0:
            raise ChildTimeError("Subtract would make the daily limit zero or negative.")
        return new_limit

    result = core.apply_limit_transaction(
        args.username,
        subtract,
        force=args.force,
        reason=f"subtract {human(delta)}",
    )
    _print_mutation_result(result)


def command_until(args):
    now = core.local_now()

    try:
        schedules = core.load_schedule_policy()
    except ChildTimeError:
        schedules = {}

    if schedules.get(args.username):
        raise ChildTimeError(
            "'until' is not supported for users with scheduled quotas."
        )

    target = core.parse_clock(args.clock, now=now)
    seconds_until = int((target - now).total_seconds())
    result = core.apply_limit_transaction(
        args.username,
        lambda old_limit, used: used + seconds_until,
        reason=f"continuous active use until {target.strftime('%H:%M')}",
    )
    _print_mutation_result(result)
    print(
        "Note       : 'until' converts the wall-clock target into remaining active "
        "usage. If the child logs out or is inactive, the quota does not expire "
        "just because that clock time passes."
    )


def build_parser():
    parser = argparse.ArgumentParser(
        prog="child-time",
        description="Human-friendly administrator CLI for OFLIT Child Time Limit.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    status = sub.add_parser("status", help="show daily usage and remaining quota")
    status.add_argument("username", nargs="?")

    set_cmd = sub.add_parser("set", help="set a user's total daily limit")
    set_cmd.add_argument("username")
    set_cmd.add_argument("duration")
    set_cmd.add_argument("--force", action="store_true")

    add = sub.add_parser("add", help="add time to a user's total daily limit")
    add.add_argument("username")
    add.add_argument("duration")

    subtract = sub.add_parser("subtract", help="subtract time from a user's daily limit")
    subtract.add_argument("username")
    subtract.add_argument("duration")
    subtract.add_argument("--force", action="store_true")

    window = sub.add_parser(
        "window",
        help="show or set the global child access window",
    )
    window.add_argument("start", nargs="?")
    window.add_argument("end", nargs="?")

    until = sub.add_parser(
        "until",
        help="set enough remaining active-use quota to reach a local HH:MM target",
    )
    until.add_argument("username")
    until.add_argument("clock")

    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)

    try:
        require_root()
        if args.command == "status":
            if args.username:
                validate_username(args.username)
            print_status(args.username)
        elif args.command == "window":
            command_window(args)
        elif args.command == "set":
            command_set(args)
        elif args.command == "add":
            command_add(args)
        elif args.command == "subtract":
            command_subtract(args)
        elif args.command == "until":
            command_until(args)
        else:
            parser.error("unknown command")
    except ChildTimeError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
