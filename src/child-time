#!/usr/bin/python3

"""Human-friendly administrator CLI for OFLIT Child Time Limit.

This script is a presentation/argument adapter: all policy semantics
(duration/clock parsing, config parsing, the transactional mutation
invariant, status computation) live in child_time_core, which this
script loads deterministically -- see _load_core() below.
"""

import argparse
import importlib.machinery
import importlib.util
import os
import sys
from pathlib import Path

_SCRIPT_PATH = Path(__file__).resolve()
_SIBLING_CORE = _SCRIPT_PATH.parent / "child_time_core.py"
_INSTALLED_CORE = Path("/usr/local/lib/child-time-limit/child_time_core.py")


def _load_core():
    """Resolve child_time_core.py deterministically.

    A source-tree checkout ships child_time_core.py next to this script,
    and that sibling always wins. An installed CLI (/usr/local/sbin/
    child-time) has no sibling core, so it falls back to the product-
    owned installed path. Both paths are re-checked on every call (no
    sys.path/sys.modules caching) so a stale installed module can never
    shadow an available sibling source module.
    """
    if _SIBLING_CORE.is_file():
        core_path = _SIBLING_CORE
    elif _INSTALLED_CORE.is_file():
        core_path = _INSTALLED_CORE
    else:
        raise ImportError(
            "Cannot locate child_time_core.py beside "
            f"{_SCRIPT_PATH} or at {_INSTALLED_CORE}"
        )

    loader = importlib.machinery.SourceFileLoader("child_time_core", str(core_path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"Cannot create import spec for {core_path}")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


core = _load_core()

# Compatibility aliases: presentation code below (and callers/tests that
# reach into this module) use these names directly, but the core module
# is the sole authoritative implementation.
ChildTimeError = core.ChildTimeError
StatusRow = core.StatusRow
LimitMutationResult = core.LimitMutationResult
parse_duration = core.parse_duration
parse_clock = core.parse_clock
validate_username = core.validate_username
load_config = core.load_config
read_used = core.read_used
policy_lock = core.policy_lock
atomic_update_limit = core.atomic_update_limit
_atomic_update_limit_locked = core._atomic_update_limit_locked
confirm_reduction = core.confirm_reduction
status_rows = core.status_rows
load_access_window = core.load_access_window
atomic_update_access_window = core.atomic_update_access_window
apply_limit_transaction = core.apply_limit_transaction
load_schedule_policy = core.load_schedule_policy
load_daily_overrides = core.load_daily_overrides
load_effective_policy = core.load_effective_policy
effective_daily_limit = core.effective_daily_limit
slots_for_weekday = core.slots_for_weekday
parse_weekday = core.parse_weekday
parse_weekday_expression = core.parse_weekday_expression
format_weekday_set = core.format_weekday_set
add_schedule = core.add_schedule
edit_schedule = core.edit_schedule
remove_schedule = core.remove_schedule
apply_daily_override_transaction = core.apply_daily_override_transaction
weekly_policy_view = core.weekly_policy_view
validate_policy = core.validate_policy
WEEKDAY_NAMES = core.WEEKDAY_NAMES
local_now = core.local_now
today = core.today
fmt = core.fmt
human = core.human


def require_root():
    if os.geteuid() != 0:
        raise ChildTimeError("Run as root, for example: sudo child-time status")


def print_status(selected=None):
    rows = core.status_rows(selected)

    print(f"OFLIT Child Time Limit — {today()}")
    print()
    print(
        f"{'USER':<20} {'USED':>10} {'REMAINING':>10} "
        f"{'LIMIT':>10} {'STATUS':>10}"
    )
    print("-" * 66)

    try:
        schedules = core.load_schedule_policy()
    except core.ChildTimeError:
        schedules = {}

    now = core.local_now()
    minute_of_day = now.hour * 60 + now.minute
    weekday = now.weekday()

    for row in rows:
        print(
            f"{row.username:<20} "
            f"{fmt(row.used):>10} "
            f"{fmt(row.remaining):>10} "
            f"{fmt(row.limit):>10} "
            f"{row.status:>10}"
        )

        if row.limit_source == "override":
            print(
                f"  Limit    : {core.WEEKDAY_NAMES[weekday]} override "
                f"{human(row.limit)}"
            )

        # Only today's schedules are shown, because only today's
        # schedules are enforced today.
        slots = core.slots_for_weekday(
            schedules.get(row.username, []),
            weekday,
        )
        if not slots:
            continue

        slot_usage = core.read_schedule_used(
            row.username,
            slots,
        )

        scheduled_status = core.scheduled_status_detail(
            slots,
            slot_usage,
            minute_of_day,
        )

        if scheduled_status.slot_id is None:
            print("  Schedule : no more slots today")
            continue

        label = (
            "current"
            if scheduled_status.mode in ("ACTIVE", "EXHAUSTED")
            else "next"
        )

        print(
            f"  Schedule : {label} "
            f"{scheduled_status.slot_id} "
            f"[{scheduled_status.mode}] "
            f"used={fmt(scheduled_status.used)} "
            f"remaining={fmt(scheduled_status.remaining)}"
        )

def _print_mutation_result(result):
    print(f"User       : {result.username}")
    print(f"Used today : {fmt(result.used)} ({human(result.used)})")
    print(f"Old limit  : {fmt(result.old_limit)} ({human(result.old_limit)})")
    print(f"New limit  : {fmt(result.new_limit)} ({human(result.new_limit)})")
    print(f"Remaining  : {fmt(result.remaining)} ({human(result.remaining)})")
    if result.reason:
        print(f"Mode       : {result.reason}")
    print("Reload     : automatic; service restart is not required")


def command_window(args):
    if args.start is None and args.end is None:
        start, end = core.load_access_window()
        print(f"Access window: {start}–{end}")
        return

    if args.start is None or args.end is None:
        raise ChildTimeError("window requires both START and END, for example: child-time window 08:00 18:00")

    start, end = core.atomic_update_access_window(args.start, args.end)
    print(f"Access window updated: {start}–{end}")


def command_set(args):
    """Set a user's daily limit, for every day or for one weekday."""
    day = getattr(args, "day", None)

    if day is None:
        result = core.apply_limit_transaction(
            args.username,
            core.parse_duration(args.duration),
            force=args.force,
        )
        _print_mutation_result(result)
        return

    weekday = core.parse_weekday(day)
    result = core.apply_daily_override_transaction(
        args.username,
        weekday,
        core.parse_duration(args.duration),
    )
    _print_mutation_result(result)
    print(
        f"Scope      : {core.WEEKDAY_NAMES[weekday]} only; "
        "other weekdays keep the base daily limit"
    )


def command_limits(args):
    """Print the effective weekly policy an administrator can audit."""
    limits, overrides, schedules = core.load_effective_policy()
    view = core.weekly_policy_view(args.username, limits, overrides, schedules)

    print(f"Effective weekly policy for {args.username}")
    print(f"Base daily limit : {human(limits[args.username])}")
    print()
    print(f"{'DAY':<5} {'DAILY LIMIT':>12} {'SOURCE':>9}  SCHEDULES")
    print("-" * 66)

    today_weekday = core.local_now().weekday()

    for weekday, limit, slots in view:
        if slots:
            detail = ", ".join(
                f"{slot.slot_id} ({human(slot.quota_seconds)})"
                for slot in slots
            )
        else:
            detail = "no scheduled restriction"

        marker = "*" if weekday == today_weekday else " "

        print(
            f"{core.WEEKDAY_NAMES[weekday]:<4}{marker} "
            f"{fmt(limit.seconds):>12} "
            f"{limit.source:>9}  {detail}"
        )

    print()
    print("* = today")

    if not schedules.get(args.username):
        print(
            "This user has no schedules, so the daily limit applies for the "
            "whole global access window."
        )


def command_validate(args):
    """Validate every policy file; non-zero exit means unsafe to activate."""
    report = core.validate_policy()

    print("Policy validation: OK")
    print(f"  limits          : {report['config']}")
    print(f"  schedules       : {report['schedule_config']}")
    print(f"  weekday limits  : {report['daily_config']}")
    print(
        "  access window   : "
        f"{report['access_window'][0]}–{report['access_window'][1]}"
    )
    print(f"  configured users: {len(report['users'])}")
    print(
        f"  schedules       : {report['schedule_count']} "
        f"across {len(report['scheduled_users'])} user(s)"
    )
    print(
        f"  weekday limits  : {report['override_count']} "
        f"across {len(report['override_users'])} user(s)"
    )


def command_schedule_list(args):
    limits, overrides, schedules = core.load_effective_policy()

    if args.username not in limits:
        raise ChildTimeError(f"User is not configured: {args.username}")

    slots = sorted(
        schedules.get(args.username, []),
        key=lambda item: (item.start_minute, item.end_minute, item.slot_id),
    )

    if not slots:
        print(f"{args.username} has no schedules.")
        print(
            "The daily limit applies across the whole global access window. "
            f"Add one with: child-time schedule add {args.username} "
            "--days mon-fri --start 15:00 --end 17:00 --quota 1h"
        )
        return

    print(f"Schedules for {args.username}")
    print()
    print(f"{'SCHEDULE_ID':<24} {'DAYS':<12} {'WINDOW':<13} {'QUOTA':>8}")
    print("-" * 66)

    for slot in slots:
        window = (
            f"{slot.start_minute // 60:02d}:{slot.start_minute % 60:02d}-"
            f"{slot.end_minute // 60:02d}:{slot.end_minute % 60:02d}"
        )
        print(
            f"{slot.slot_id:<24} "
            f"{core.format_weekday_set(slot.days):<12} "
            f"{window:<13} "
            f"{human(slot.quota_seconds):>8}"
        )


def _print_schedule_mutation(result):
    print(f"User       : {result.username}")
    print(f"Action     : {result.action}")
    if result.previous_slot_id and result.previous_slot_id != result.slot_id:
        print(f"Schedule   : {result.previous_slot_id} -> {result.slot_id}")
        print(
            "Note       : changing the days or the window changes the "
            "schedule identifier, so that schedule's usage for today "
            "restarts from zero"
        )
    else:
        print(f"Schedule   : {result.slot_id}")
    print("Reload     : automatic; service restart is not required")


def command_schedule_add(args):
    result = core.add_schedule(
        args.username,
        args.days,
        args.start,
        args.end,
        core.parse_duration(args.quota),
    )
    _print_schedule_mutation(result)


def command_schedule_edit(args):
    result = core.edit_schedule(
        args.username,
        args.schedule_id,
        days=args.days,
        start=args.start,
        end=args.end,
        quota_seconds=(
            None if args.quota is None else core.parse_duration(args.quota)
        ),
    )
    _print_schedule_mutation(result)


def command_schedule_remove(args):
    result = core.remove_schedule(args.username, args.schedule_id)
    _print_schedule_mutation(result)


def command_add(args):
    delta = core.parse_duration(args.duration)
    result = core.apply_limit_transaction(
        args.username,
        lambda old_limit, used: old_limit + delta,
        reason=f"add {human(delta)}",
    )
    _print_mutation_result(result)


def command_subtract(args):
    delta = core.parse_duration(args.duration)

    def subtract(old_limit, used):
        new_limit = old_limit - delta
        if new_limit <= 0:
            raise ChildTimeError("Subtract would make the daily limit zero or negative.")
        return new_limit

    result = core.apply_limit_transaction(
        args.username,
        subtract,
        force=args.force,
        reason=f"subtract {human(delta)}",
    )
    _print_mutation_result(result)


def command_until(args):
    now = core.local_now()

    try:
        schedules = core.load_schedule_policy()
    except ChildTimeError:
        schedules = {}

    if schedules.get(args.username):
        raise ChildTimeError(
            "'until' is not supported for users with scheduled quotas."
        )

    target = core.parse_clock(args.clock, now=now)
    seconds_until = int((target - now).total_seconds())
    result = core.apply_limit_transaction(
        args.username,
        lambda old_limit, used: used + seconds_until,
        reason=f"continuous active use until {target.strftime('%H:%M')}",
    )
    _print_mutation_result(result)
    print(
        "Note       : 'until' converts the wall-clock target into remaining active "
        "usage. If the child logs out or is inactive, the quota does not expire "
        "just because that clock time passes."
    )


def build_parser():
    parser = argparse.ArgumentParser(
        prog="child-time",
        description="Human-friendly administrator CLI for OFLIT Child Time Limit.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    status = sub.add_parser("status", help="show daily usage and remaining quota")
    status.add_argument("username", nargs="?")

    set_cmd = sub.add_parser("set", help="set a user's total daily limit")
    set_cmd.add_argument("username")
    set_cmd.add_argument("duration")
    set_cmd.add_argument("--force", action="store_true")
    set_cmd.add_argument(
        "--day",
        metavar="DAY",
        help=(
            "set this weekday's daily limit only (mon..sun); "
            "omit to set the base limit for every weekday"
        ),
    )

    limits_cmd = sub.add_parser(
        "limits",
        help="show the effective per-weekday policy for a user",
    )
    limits_cmd.add_argument("username")

    sub.add_parser(
        "validate",
        help="validate every policy file without changing anything",
    )

    schedule = sub.add_parser(
        "schedule",
        help="manage a user's weekly scheduled quotas",
    )
    schedule_sub = schedule.add_subparsers(
        dest="schedule_command",
        required=True,
    )

    schedule_list = schedule_sub.add_parser(
        "list",
        help="list a user's schedules",
    )
    schedule_list.add_argument("username")

    schedule_add = schedule_sub.add_parser(
        "add",
        help="add a schedule for a user",
    )
    schedule_add.add_argument("username")
    schedule_add.add_argument(
        "--days",
        help=(
            "weekday expression, for example: fri | mon-fri | sat,sun | "
            "daily (default: daily)"
        ),
    )
    schedule_add.add_argument("--start", required=True, metavar="HH:MM")
    schedule_add.add_argument("--end", required=True, metavar="HH:MM")
    schedule_add.add_argument(
        "--quota",
        required=True,
        metavar="DURATION",
        help="active-use quota inside the window, for example 1h or 90m",
    )

    schedule_edit = schedule_sub.add_parser(
        "edit",
        help="edit one of a user's schedules",
    )
    schedule_edit.add_argument("username")
    schedule_edit.add_argument(
        "schedule_id",
        metavar="SCHEDULE_ID",
        help="identifier shown by `child-time schedule list`",
    )
    schedule_edit.add_argument("--days")
    schedule_edit.add_argument("--start", metavar="HH:MM")
    schedule_edit.add_argument("--end", metavar="HH:MM")
    schedule_edit.add_argument("--quota", metavar="DURATION")

    schedule_remove = schedule_sub.add_parser(
        "remove",
        help="remove one of a user's schedules",
    )
    schedule_remove.add_argument("username")
    schedule_remove.add_argument("schedule_id", metavar="SCHEDULE_ID")

    add = sub.add_parser("add", help="add time to a user's total daily limit")
    add.add_argument("username")
    add.add_argument("duration")

    subtract = sub.add_parser("subtract", help="subtract time from a user's daily limit")
    subtract.add_argument("username")
    subtract.add_argument("duration")
    subtract.add_argument("--force", action="store_true")

    window = sub.add_parser(
        "window",
        help="show or set the global child access window",
    )
    window.add_argument("start", nargs="?")
    window.add_argument("end", nargs="?")

    until = sub.add_parser(
        "until",
        help="set enough remaining active-use quota to reach a local HH:MM target",
    )
    until.add_argument("username")
    until.add_argument("clock")

    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)

    try:
        require_root()
        if args.command == "status":
            if args.username:
                validate_username(args.username)
            print_status(args.username)
        elif args.command == "window":
            command_window(args)
        elif args.command == "set":
            command_set(args)
        elif args.command == "add":
            command_add(args)
        elif args.command == "subtract":
            command_subtract(args)
        elif args.command == "until":
            command_until(args)
        elif args.command == "limits":
            validate_username(args.username)
            command_limits(args)
        elif args.command == "validate":
            command_validate(args)
        elif args.command == "schedule":
            validate_username(args.username)
            if args.schedule_command == "list":
                command_schedule_list(args)
            elif args.schedule_command == "add":
                command_schedule_add(args)
            elif args.schedule_command == "edit":
                command_schedule_edit(args)
            elif args.schedule_command == "remove":
                command_schedule_remove(args)
            else:
                parser.error("unknown schedule command")
        else:
            parser.error("unknown command")
    except ChildTimeError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
