#!/usr/bin/python3

import os
import sys
from datetime import datetime
from pathlib import Path

CONFIG = "/etc/child-time-limit.conf"
STATE_DIR = "/var/lib/child-time-limit"

ACCESS_CONFIG = Path("/etc/child-time-access.conf")
DEFAULT_ACCESS_START = (9, 0)
DEFAULT_ACCESS_END = (17, 0)


def load_access_window():
    start = DEFAULT_ACCESS_START
    end = DEFAULT_ACCESS_END

    try:
        lines = ACCESS_CONFIG.read_text().splitlines()
    except FileNotFoundError:
        return start, end
    except OSError:
        return start, end

    values = {}
    try:
        for raw in lines:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            key, value = (part.strip() for part in line.split("=", 1))
            if key not in ("start", "end") or key in values:
                return DEFAULT_ACCESS_START, DEFAULT_ACCESS_END
            hour, minute = map(int, value.split(":"))
            if not (0 <= hour <= 23 and 0 <= minute <= 59):
                return DEFAULT_ACCESS_START, DEFAULT_ACCESS_END
            values[key] = (hour, minute)
    except (ValueError, TypeError):
        return DEFAULT_ACCESS_START, DEFAULT_ACCESS_END

    start = values.get("start", start)
    end = values.get("end", end)

    if start >= end:
        return DEFAULT_ACCESS_START, DEFAULT_ACCESS_END

    return start, end


def within_access_window(now):
    start, end = load_access_window()
    current = (now.hour, now.minute)
    return start <= current < end


username = os.environ.get("PAM_USER", "")

limits = {}
try:
    with open(CONFIG) as handle:
        for raw in handle:
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            name, seconds = line.split("=", 1)
            name = name.strip()
            seconds = int(seconds.strip())
            if name and seconds > 0:
                limits[name] = seconds
except Exception:
    # Fail open so configuration problems cannot lock out unrelated admins.
    sys.exit(0)

if username not in limits:
    sys.exit(0)

now = datetime.now().astimezone()

if not within_access_window(now):
    window_start, window_end = load_access_window()
    print(
        "Computer access is allowed only between "
        f"{window_start[0]:02d}:{window_start[1]:02d} and "
        f"{window_end[0]:02d}:{window_end[1]:02d}."
    )
    sys.exit(1)

today = now.date().isoformat()
path = os.path.join(STATE_DIR, username + ".state")
used = 0

try:
    with open(path) as handle:
        parts = handle.read().strip().split()
    if len(parts) >= 2 and parts[0] == today:
        used = int(float(parts[1]))
except (FileNotFoundError, ValueError, OSError):
    pass

if used >= limits[username]:
    print("Daily computer time limit has been reached.")
    sys.exit(1)

sys.exit(0)
