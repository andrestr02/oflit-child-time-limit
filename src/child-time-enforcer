#!/usr/bin/python3

import fcntl
import os
import subprocess
import time
from datetime import datetime
from pathlib import Path

CONFIG = "/etc/child-time-limit.conf"
STATE_DIR = "/var/lib/child-time-limit"
LOCK_FILE = "/run/child-time-limit.lock"
POLL_SECONDS = 1.0

ACCESS_CONFIG = Path("/etc/child-time-access.conf")
DEFAULT_ACCESS_START = (9, 0)
DEFAULT_ACCESS_END = (17, 0)


def load_access_window():
    start = DEFAULT_ACCESS_START
    end = DEFAULT_ACCESS_END

    try:
        lines = ACCESS_CONFIG.read_text().splitlines()
    except FileNotFoundError:
        return start, end
    except OSError:
        return start, end

    values = {}
    try:
        for raw in lines:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            key, value = (part.strip() for part in line.split("=", 1))
            if key not in ("start", "end") or key in values:
                return DEFAULT_ACCESS_START, DEFAULT_ACCESS_END
            hour, minute = map(int, value.split(":"))
            if not (0 <= hour <= 23 and 0 <= minute <= 59):
                return DEFAULT_ACCESS_START, DEFAULT_ACCESS_END
            values[key] = (hour, minute)
    except (ValueError, TypeError):
        return DEFAULT_ACCESS_START, DEFAULT_ACCESS_END

    start = values.get("start", start)
    end = values.get("end", end)

    if start >= end:
        return DEFAULT_ACCESS_START, DEFAULT_ACCESS_END

    return start, end


def within_access_window(now):
    start, end = load_access_window()
    current = (now.hour, now.minute)
    return start <= current < end


def local_day():
    return datetime.now().astimezone().date().isoformat()


def load_limits():
    limits = {}
    try:
        with open(CONFIG) as handle:
            for raw in handle:
                line = raw.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                username, seconds = line.split("=", 1)
                username = username.strip()
                seconds = int(seconds.strip())
                if username and seconds > 0:
                    limits[username] = seconds
    except Exception:
        # Fail open if configuration cannot be parsed. Only explicitly
        # configured accounts are ever enforced.
        return {}
    return limits


def state_path(username):
    return os.path.join(STATE_DIR, username + ".state")


def read_state(username, day):
    try:
        with open(state_path(username)) as handle:
            parts = handle.read().strip().split()
        if len(parts) >= 2 and parts[0] == day:
            return float(parts[1])
    except (FileNotFoundError, ValueError, OSError):
        pass
    return 0.0


def write_state(username, day, used):
    path = state_path(username)
    temporary = path + ".tmp"
    persisted = int(used)

    with open(temporary, "w") as handle:
        handle.write(f"{day} {persisted}\n")
        handle.flush()
        os.fsync(handle.fileno())

    os.replace(temporary, path)
    os.chmod(path, 0o600)


def active_graphical_users(limits):
    result = subprocess.run(
        ["loginctl", "list-sessions", "--no-legend"],
        text=True,
        capture_output=True,
        check=False,
    )

    users = set()

    for line in result.stdout.splitlines():
        fields = line.split()
        if not fields:
            continue

        session = fields[0]
        details = subprocess.run(
            [
                "loginctl",
                "show-session",
                session,
                "-p", "Name",
                "-p", "Type",
                "-p", "Class",
                "-p", "Active",
            ],
            text=True,
            capture_output=True,
            check=False,
        )

        info = {}
        for item in details.stdout.splitlines():
            if "=" in item:
                key, value = item.split("=", 1)
                info[key] = value

        username = info.get("Name", "")
        if (
            username in limits
            and info.get("Class") == "user"
            and info.get("Active") == "yes"
            and info.get("Type") in ("wayland", "x11")
        ):
            users.add(username)

    return users


def terminate(username):
    subprocess.run(
        ["loginctl", "terminate-user", username],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )




def main():
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)

    # Only one enforcer instance may run at a time.
    lock = open(LOCK_FILE, "w")
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)


    limits = load_limits()
    previous_active = active_graphical_users(limits)
    previous_tick = time.monotonic()
    usage_cache = {}
    cache_day = local_day()

    while True:
        time.sleep(POLL_SECONDS)

        now = time.monotonic()
        elapsed = max(0.0, now - previous_tick)
        previous_tick = now

        day = local_day()
        if day != cache_day:
            usage_cache.clear()
            cache_day = day

        limits = load_limits()
        current_active = active_graphical_users(limits)

        # Charge the interval to users who were active at the start of it.
        # A login/logout transition can therefore differ by at most one poll.
        for username in previous_active:
            if username not in limits:
                continue

            limit = limits[username]

            if username not in usage_cache:
                usage_cache[username] = read_state(username, day)

            used = usage_cache[username]

            if used >= limit:
                # A policy reduction must never erase already-consumed usage.
                # Keep the historical state as-is and enforce the new lower limit.
                terminate(username)
                continue

            used = min(float(limit), used + elapsed)
            usage_cache[username] = used

            # Persist before enforcement so reboot cannot restore consumed time.
            write_state(username, day, used)

            if used >= limit:
                terminate(username)

        wall_now = datetime.now().astimezone()
        if not within_access_window(wall_now):
            for username in current_active:
                terminate(username)

        previous_active = current_active


if __name__ == "__main__":
    main()
