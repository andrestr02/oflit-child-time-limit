[Unit]
Description=OFLIT Child Time Limit privileged D-Bus backend
After=dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=id.oflit.ChildTime1
ExecStart=/usr/local/sbin/child-time-backend
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
